# Public Vite Firebase web config only (safe to expose in client bundles).
# Copy to apps/customer/.env and apps/admin/.env (or root .env) and fill from
# Firebase Console → Project settings → Your apps → Web app.
# Never put service-account keys, Admin SDK credentials, or private keys here.
# Never reuse project hloe-45d43.
#
# Known RAMKIN project (public identifiers only):
#   projectId: ramkincoffee
#   project number / messagingSenderId: 392513147835

# TODO: paste from Console → Project settings → Web app (do not invent)
VITE_FIREBASE_API_KEY=

VITE_FIREBASE_AUTH_DOMAIN=ramkincoffee.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ramkincoffee

# Best-effort Firebase default bucket name — confirm in Console → Storage
# (newer projects may use ramkincoffee.firebasestorage.app instead).
VITE_FIREBASE_STORAGE_BUCKET=ramkincoffee.appspot.com

VITE_FIREBASE_MESSAGING_SENDER_ID=392513147835

# TODO: paste from Console → Project settings → Web app (do not invent)
VITE_FIREBASE_APP_ID=

# App Check (optional until Console enrollment) — public reCAPTCHA v3 site key only.
# Register apps in Firebase Console → App Check, then set:
# VITE_FIREBASE_APPCHECK_SITE_KEY=
# After enforcing in Console, set Functions env ENFORCE_APP_CHECK=true (not a Vite var).

# Spark-safe local path (NO Blaze / NO paid SMS):
# 1) firebase emulators:start --only auth,functions,firestore
# 2) set the flag below to true in each app .env
# 3) Use Email/Password for staff; phone OTP via Auth emulator or Console test numbers only
# VITE_USE_FIREBASE_EMULATORS=true
#
# Cost / billing notes: see docs/FIREBASE_COST_REPORT.md
# Cloud Functions v2 deploy requires Blaze — do not upgrade without OWNER approval.

# Optional: separate Hosting targets later
# VITE_CUSTOMER_URL=http://localhost:5173
# VITE_ADMIN_URL=http://localhost:5174

