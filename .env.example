# Public Vite Firebase web config only (safe to expose in client bundles).
# Copy to apps/customer/.env and apps/admin/.env (or root .env).
# Never put service-account keys, Admin SDK credentials, or private keys here.
# Never reuse project hloe-45d43.
#
# Sourced from Firebase Console → Project settings → Web app "RAMKIN Web"
# (project ramkincoffee / number 392513147835) on 2026-11-21. These values are
# public client identifiers by design — not secrets.

VITE_FIREBASE_API_KEY=AIzaSyDnowBTQmlqnWcV7tf7yUebVmvXAft8M5A
VITE_FIREBASE_AUTH_DOMAIN=ramkincoffee.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ramkincoffee
VITE_FIREBASE_STORAGE_BUCKET=ramkincoffee.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=392513147835
