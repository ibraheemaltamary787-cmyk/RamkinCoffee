# Public Vite Firebase web config only (safe to expose in client bundles).
# Copy to apps/customer/.env and apps/admin/.env (or root .env) and fill from
# Firebase Console → Project settings → Your apps → Web app.
# Never put service-account keys, Admin SDK credentials, or private keys here.
# Never reuse project hloe-45d43.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (optional until Console enrollment) — public reCAPTCHA v3 site key only.
# Register apps in Firebase Console → App Check, then set:
# VITE_FIREBASE_APPCHECK_SITE_KEY=
# After enforcing in Console, set Functions env ENFORCE_APP_CHECK=true (not a Vite var).

# Local OTP / Auth without a live SMS provider:
# 1) firebase emulators:start --only auth,functions,firestore
# 2) set the flag below to true in each app .env
# VITE_USE_FIREBASE_EMULATORS=true

# Optional: separate Hosting targets later
# VITE_CUSTOMER_URL=http://localhost:5173
# VITE_ADMIN_URL=http://localhost:5174

# --- Functions-only secrets (NOT Vite; set via Firebase Secret Manager) ---
# firebase functions:secrets:set BOOTSTRAP_OWNER_SECRET
# BOOTSTRAP_OWNER_SECRET=
# ENFORCE_APP_CHECK=true   # only after App Check Console enforcement is live
