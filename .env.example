# Optional Analytics measurement id from the same web app (not required by Vite apps today):
# G-0JH19WWFGQ

# App Check (optional until Console enrollment) — public reCAPTCHA v3 site key only.
# Register apps in Firebase Console → App Check, then set:
# VITE_FIREBASE_APPCHECK_SITE_KEY=
# After enforcing in Console, set Functions env ENFORCE_APP_CHECK=true (not a Vite var).

# Spark-safe local path (NO Blaze / NO paid SMS / NO Hosting publish):
# Full steps: docs/FIREBASE_EMULATOR_DEV.md
# 1) cp functions/.secret.local.example functions/.secret.local
# 2) Uncomment the flag below in each app .env (customer + admin)
# 3) npm run emulators
# 4) npm run dev:customer  +  npm run dev:admin
# Staff: Email/Password via Emulator UI → bootstrap OWNER against Functions emulator.
# Customers (Spark keep-free): Email/Password register/login in the customer app.
# Optional phone OTP: Auth Emulator (code prints in emulator terminal) via /login/phone.
# Optional seed: npm run seed:emulator -- --phone +15550109999 --n 3 --stop-at approved
# Optional live Auth without SMS: Console → Auth → Phone → "Phone numbers for testing"
#    (emulators OFF; fictional numbers only). Do not enable production SMS regions.
# Default true for local Spark keep-free. Before any production Hosting build, set false or remove.
VITE_USE_FIREBASE_EMULATORS=true
#
# Cost / billing notes: see docs/FIREBASE_COST_REPORT.md
# Cloud Functions v2 deploy requires Blaze — do not upgrade without OWNER approval.
# Storage Console currently requires Blaze for this project — do not enable without approval.

# Optional: separate Hosting targets later
# VITE_CUSTOMER_URL=http://localhost:5173
# VITE_ADMIN_URL=http://localhost:5174

# --- Functions-only secrets (NOT Vite; set via Firebase Secret Manager) ---
# firebase functions:secrets:set BOOTSTRAP_OWNER_SECRET
# BOOTSTRAP_OWNER_SECRET=
# ENFORCE_APP_CHECK=true   # only after App Check Console enforcement is live
