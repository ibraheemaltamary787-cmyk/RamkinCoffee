# Public Vite Firebase web config only (safe to expose in client bundles).
# Copy to apps/customer/.env and apps/admin/.env (or root .env) and fill from
# Firebase Console → Project settings → Your apps → Web app.
# Never put service-account keys, Admin SDK credentials, or private keys here.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: separate Hosting targets later
# VITE_CUSTOMER_URL=http://localhost:5173
# VITE_ADMIN_URL=http://localhost:5174
