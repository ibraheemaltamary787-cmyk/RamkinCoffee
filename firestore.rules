rules_version = '2';

// RAMKIN Coffee — Phase 6 hardening.
// Privileged writes (purchases, rewards, settings, roles, invites, activityLogs,
// exports, rateLimits) stay in Cloud Functions. Clients get narrow reads only.
// See docs/SECURITY_RULES_REVIEW.md for the checklist.

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function claimRole() {
      return signedIn() && 'role' in request.auth.token
        ? request.auth.token.role
        : null;
    }

    function isSelf(userId) {
      return signedIn() && uid() == userId;
    }

    function isStaff() {
      return claimRole() in ['OWNER', 'MANAGER', 'STAFF'];
    }

    function isManagerOrOwner() {
      return claimRole() in ['OWNER', 'MANAGER'];
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isStaff();
      // Role / status / email mutations only via Admin SDK callables.
      allow create, update, delete: if false;
    }

    match /customers/{customerId} {
      allow read: if isSelf(customerId) || isStaff();
      allow create, update, delete: if false;
    }

    match /combos/{comboId} {
      allow read: if signedIn() && (
        resource.data.customerId == uid() || isStaff()
      );
      allow create, update, delete: if false;
    }

    match /purchases/{purchaseId} {
      allow read: if signedIn() && (
        resource.data.customerId == uid() || isStaff()
      );
      allow create, update, delete: if false;
    }

    match /rewardRequests/{requestId} {
      allow read: if signedIn() && (
        resource.data.customerId == uid() || isStaff()
      );
      allow create, update, delete: if false;
    }

    match /settings/{docId} {
      // Customers may read loyalty N for progress UI; writes via Functions only.
      allow read: if signedIn();
      allow write: if false;
    }

    match /staffInvites/{inviteId} {
      allow read: if isManagerOrOwner();
      allow write: if false;
    }

    match /activityLogs/{logId} {
      allow read: if isManagerOrOwner();
      allow write: if false;
    }

    // Server-side rate limit ledger — never client-readable.
    match /rateLimits/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
