# Copy to functions/.secret.local (gitignored via *.local) for Functions emulator only.
# Never commit real production secrets. Never put these in Vite / apps/*/.env.
#
# Used by defineSecret('BOOTSTRAP_OWNER_SECRET') when running:
#   npm run emulators
#
# The Bootstrap page expects the same string (min 16 chars).

BOOTSTRAP_OWNER_SECRET=local-dev-bootstrap-secret
